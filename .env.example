# .env.example
# Usage: copy to apps/api/.env (or export in your shell) and adjust:
#   cp .env.example apps/api/.env
# Never commit real secrets. In production set these via your secret manager.

# --- API server ---
NODE_ENV=development
API_PORT=4000
# Comma-separated origins allowed to call the API with cookies
WEB_ORIGIN=http://localhost:5173
# At least 32 random characters: openssl rand -hex 32
JWT_SECRET=change-me-change-me-change-me-change-me

# --- Data stores ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/billdude
REDIS_URL=redis://localhost:6379

# --- Virtuozzo Hybrid Infrastructure (OpenStack-compatible APIs) ---
# Keystone v3 endpoint. Locally this points at the mock VHI server (pnpm --filter @billdude/mock-vhi dev).
VHI_AUTH_URL=http://localhost:5050/identity/v3
VHI_USERNAME=admin
VHI_PASSWORD=admin
VHI_USER_DOMAIN=Default
VHI_PROJECT_NAME=billdude
VHI_PROJECT_DOMAIN=Default
# Optional region filter for the service catalog
VHI_REGION=
# Boot disks are Cinder volumes on VHI. Optional storage policy (volume type) name.
VHI_VOLUME_TYPE=
# Each customer gets their own project named <prefix><account id>. The service user must be
# allowed to create projects and assign roles in its domain; it grants itself this role on them.
VHI_PROJECT_PREFIX=billdude-
VHI_MEMBER_ROLE=member
# Comma-separated network ids customers may use. Empty = every shared network.
VHI_ALLOWED_NETWORK_IDS=

# --- Default per-customer quotas (admins can override per customer; -1 = unlimited) ---
QUOTA_INSTANCES=5
QUOTA_CORES=10
QUOTA_RAM_MB=20480
QUOTA_VOLUMES=10
QUOTA_GIGABYTES=500

# --- First admin user (used by `pnpm seed:admin`) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-please
