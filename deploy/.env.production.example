# deploy/.env.production.example
# Usage: template for production secrets. Copy to deploy/.env (never commit it) and fill in:
#   cp deploy/.env.production.example deploy/.env && chmod 600 deploy/.env
# Used by: docker compose -f deploy/docker-compose.prod.yml --env-file deploy/.env up -d --build
# Any variable from .env.example (quotas, billing prices, …) can also be set here.

# Public hostname pointing at this server (A/AAAA record); HTTPS is automatic.
DOMAIN=cloud.example.com

# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=

# Virtuozzo Hybrid Infrastructure (Keystone v3 endpoint of the compute API)
VHI_AUTH_URL=https://vhi.example.com:5000/v3
VHI_USERNAME=billdude
VHI_PASSWORD=
VHI_USER_DOMAIN=Default
VHI_PROJECT_NAME=billdude
VHI_PROJECT_DOMAIN=Default
VHI_VOLUME_TYPE=
VHI_ALLOWED_NETWORK_IDS=

# Razorpay live (or test) keys and webhook secret
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
BILLING_COMPANY_NAME=billdude

# First admin (run the seed command once after the first start)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
